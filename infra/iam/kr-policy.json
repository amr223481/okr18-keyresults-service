{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnTableOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/KeyResults",
        "arn:aws:dynamodb:us-east-1:000000000000:table/KeyResults/index/goalId-index"
      ]
    },
    {
      "Sid": "ReadOwnQueue",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:ChangeMessageVisibility"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:kr-inbox"
    },
    {
      "Sid": "PublishKrEvents",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:okr-events"
    },
    {
      "Sid": "AskGoalsForParentGoal",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:goals-internal"
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/kr-*"
    }
  ]
}
